  <h:body>
    <input ref="/data/resp_code">
      <label>Submission code: type A, B or C as told in the instructions</label>
    </input>
    <group ref="/data/oracle">
      <label>Calculations (nothing to enter)</label>
      <select1 ref="/data/oracle/sel_default">
        <label>Pre-selected answer: leave Beta selected</label>
        <itemset nodeset="instance('abc')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/oracle/never_shown">
        <label>Never shown</label>
      </input>
      <input ref="/data/oracle/n_auto">
        <label>Number of computed rows (read only, 3)</label>
      </input>
      <group ref="/data/oracle/auto">
        <label>Computed row</label>
        <repeat nodeset="/data/oracle/auto" jr:count=" /data/oracle/n_auto "/>
      </group>
      <group ref="/data/oracle/expr_rep">
        <label>Row counted by an expression</label>
        <repeat nodeset="/data/oracle/expr_rep" jr:count=" /data/oracle/expr_rep_count "/>
      </group>
    </group>
    <group ref="/data/defaults">
      <label>Defaults</label>
      <input ref="/data/defaults/def_keep">
        <label>Pre-filled 7: do NOT change it</label>
      </input>
      <input ref="/data/defaults/def_change">
        <label>Pre-filled 'abc': replace it with xyz</label>
      </input>
      <input ref="/data/defaults/calc_default">
        <label>Calculated (7 x 2): try to change it to 99</label>
      </input>
    </group>
    <group ref="/data/values">
      <label>Text and numbers</label>
      <input ref="/data/values/t_comma_quote">
        <label>Type exactly: Hello, "world"</label>
      </input>
      <input ref="/data/values/t_accents">
        <label>Type exactly: Élodie à Ouagadougou, niño</label>
      </input>
      <input ref="/data/values/t_leading_zeros">
        <label>Type exactly: 007</label>
      </input>
      <input ref="/data/values/t_numbers" appearance="numbers">
        <label>Type exactly: 012345678901</label>
      </input>
      <input ref="/data/values/t_numbers_decimal" appearance="numbers_decimal">
        <label>Type exactly: 3.50</label>
      </input>
      <input ref="/data/values/d_whole">
        <label>Type exactly: 5</label>
      </input>
      <input ref="/data/values/d_trailing_zero">
        <label>Type exactly: 0.10</label>
      </input>
      <input ref="/data/values/d_negative">
        <label>Type exactly: -3.75</label>
      </input>
      <input ref="/data/values/i_negative">
        <label>Type exactly: -12</label>
      </input>
      <input ref="/data/values/i_large">
        <label>Type exactly: 123456789</label>
      </input>
      <input ref="/data/values/i_minimum_time">
        <label>Type 1 (this question has a minimum time)</label>
      </input>
    </group>
    <group ref="/data/dates">
      <label>Dates and times</label>
      <input ref="/data/dates/dt_old">
        <label>Enter 15 June 1950</label>
      </input>
      <input ref="/data/dates/dt_month_year" appearance="month-year">
        <label>Enter March 2025</label>
      </input>
      <input ref="/data/dates/dt_month" appearance="month">
        <label>Enter any month (note which)</label>
      </input>
      <input ref="/data/dates/dt_no_calendar" appearance="no-calendar">
        <label>Enter 31 December 2025</label>
      </input>
      <input ref="/data/dates/tm_after_midnight">
        <label>Enter 00:05 (5 minutes past midnight)</label>
      </input>
      <input ref="/data/dates/tm_noon">
        <label>Enter 12:30 (half past noon)</label>
      </input>
      <input ref="/data/dates/dtm_any">
        <label>Enter 1 January 2026, 23:59</label>
      </input>
    </group>
    <group ref="/data/selects">
      <label>Choices</label>
      <select1 ref="/data/selects/s_minimal" appearance="minimal">
        <label>Drop-down: choose Eleven</label>
        <itemset nodeset="instance('many')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/selects/s_likert" appearance="likert">
        <label>Scale: choose Agree</label>
        <itemset nodeset="instance('agree')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/selects/s_randomized" appearance="randomized">
        <label>Shuffled list: choose Ten</label>
        <itemset nodeset="instance('many')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select ref="/data/selects/m_many">
        <label>Tick One, Ten and Twelve</label>
        <itemset nodeset="instance('many')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select ref="/data/selects/m_blank">
        <label>Leave this question BLANK (tick nothing)</label>
        <itemset nodeset="instance('many')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/selects/s_comma_label">
        <label>Choose 'Yes, sure'</label>
        <itemset nodeset="instance('comma_labels')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/selects/s_other">
        <label>Choose Other</label>
        <itemset nodeset="instance('other')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/selects/s_other_specify">
        <label>Specify: type Bananas</label>
      </input>
      <select1 ref="/data/selects/region">
        <label>Region: choose South</label>
        <itemset nodeset="instance('region')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/selects/district">
        <label>District: choose South-B</label>
        <itemset nodeset="instance('district')/root/item[filter =  /data/selects/region ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select ref="/data/selects/districts_multi">
        <label>Districts of the chosen region: tick both</label>
        <itemset nodeset="instance('district')/root/item[filter =  /data/selects/region ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/selects/village" appearance="search('villages', 'matches', 'region',  /data/selects/region )">
        <label>Village (loaded from villages.csv, South only): choose Hawassa</label>
        <item>
          <label>village_name</label>
          <value>village_id</value>
        </item>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/screen">
      <label>One screen (field-list)</label>
      <input ref="/data/screen/fl_a">
        <label>Type 1</label>
      </input>
      <input ref="/data/screen/fl_b">
        <label>Type 2</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/table">
      <label>Table (label / list-nolabel)</label>
      <select1 ref="/data/table/tbl_header" appearance="label">
        <label>How often?</label>
        <itemset nodeset="instance('freq')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/table/tbl_water" appearance="list-nolabel">
        <label>Water: Often</label>
        <itemset nodeset="instance('freq')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/table/tbl_power" appearance="list-nolabel">
        <label>Power: Never</label>
        <itemset nodeset="instance('freq')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group ref="/data/skipped">
      <label>Never shown group</label>
      <input ref="/data/skipped/skipped_text">
        <label>Never shown</label>
      </input>
    </group>
    <group ref="/data/outer">
      <label>Nested groups</label>
      <group ref="/data/outer/middle">
        <label>Middle</label>
        <group ref="/data/outer/middle/inner">
          <label>Inner</label>
          <input ref="/data/outer/middle/inner/deep_text">
            <label>Type: deep</label>
          </input>
        </group>
      </group>
    </group>
    <input ref="/data/n_people">
      <label>Number of people: type 2 (C: type 0)</label>
    </input>
    <group ref="/data/person">
      <label>Person</label>
      <repeat nodeset="/data/person" jr:count=" /data/n_people ">
        <input ref="/data/person/p_name">
          <label>Name (any)</label>
        </input>
        <input ref="/data/person/p_age">
          <label>Age: person 1 is 30, person 2 is 5</label>
        </input>
        <input ref="/data/person/p_school">
          <label>School name (any)</label>
        </input>
        <input ref="/data/person/this_field_name_is_longer_than_thirty_two_characters">
          <label>Long field name: type x</label>
        </input>
        <group ref="/data/person/health">
          <label>Health</label>
          <group ref="/data/person/health/visit">
            <label>Health visit (person 1: add 2, person 2: add 0)</label>
            <repeat nodeset="/data/person/health/visit">
              <input ref="/data/person/health/visit/visit_date">
                <label>Visit date (any)</label>
              </input>
            </repeat>
          </group>
        </group>
      </repeat>
    </group>
    <group ref="/data/media">
      <label>Media and locations</label>
      <upload ref="/data/media/m_audio" mediatype="audio/*">
        <label>Record 2 seconds of audio</label>
      </upload>
      <upload ref="/data/media/m_video" mediatype="video/*">
        <label>Record 2 seconds of video (or skip on the web)</label>
      </upload>
      <upload ref="/data/media/m_file" mediatype="application/*">
        <label>Attach any small file (or skip)</label>
      </upload>
      <upload ref="/data/media/m_signature" mediatype="image/*" appearance="signature">
        <label>Sign here</label>
      </upload>
      <input ref="/data/media/m_barcode">
        <label>Scan any barcode (or skip on the web)</label>
      </input>
      <input ref="/data/media/g_trace">
        <label>Record a short line of 2 to 3 points</label>
      </input>
      <input ref="/data/media/g_shape">
        <label>Record a small shape of 3 to 4 points</label>
      </input>
    </group>
    <input ref="/data/thanks">
      <label>Thank you. Add a comment on one question before finishing (not in submission C).</label>
    </input>
  </h:body>
</h:html>
