      <bind nodeset="/data/oracle/agg_sum" type="string" calculate="sum( /data/oracle/auto/a_value )"/>
      <bind nodeset="/data/oracle/agg_min" type="string" calculate="min( /data/oracle/auto/a_value )"/>
      <bind nodeset="/data/oracle/agg_max" type="string" calculate="max( /data/oracle/auto/a_value )"/>
