<h:html xmlns:h="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/2002/xforms"
        xmlns:jr="http://openrosa.org/javarosa" xmlns:ct="http://www.surveycto.com/xforms">
  <h:head><h:title>Revisit identification</h:title><model>
    <instance><data id="revisit-identification"><answer/><attempt/>__NODES__<status/></data></instance>
    __SECONDARY__
    <bind nodeset="/data/answer" type="int"/>
    <bind nodeset="/data/attempt" type="int"/>
    __BINDS__
    <bind nodeset="/data/status" type="string"/>
  </model></h:head>
  <h:body>
    <input ref="/data/answer"><label>Household</label></input>
    <input ref="/data/attempt"><label>Visit number</label></input>
    __BEFORE__
    <select1 ref="/data/status"><label>Availability</label>
      <item><label>Found</label><value>yes</value></item>
      <item><label>Absent</label><value>absent</value></item>
    </select1>
    __AFTER__
  </h:body>
</h:html>
