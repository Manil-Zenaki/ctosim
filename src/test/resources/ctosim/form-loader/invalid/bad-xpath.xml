<h:html xmlns:h="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/2002/xforms">
  <h:head><h:title>Invalid XPath</h:title><model>
    <instance><data id="bad-xpath"><answer/><result/></data></instance>
    <bind nodeset="/data/answer" type="string"/>
    <bind nodeset="/data/result" type="string" calculate="concat('unterminated'"/>
  </model></h:head>
  <h:body><input ref="/data/answer"><label>Answer</label></input></h:body>
</h:html>
