<h:html xmlns:h="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/2002/xforms" xmlns:jr="http://openrosa.org/javarosa">
  <h:head>
    <h:title>Expression test</h:title>
    <model>
      <instance><data id="expression"><answer>sample</answer><result/></data></instance>
      <bind nodeset="/data/answer" type="string"/>
      <bind nodeset="/data/result" type="string" calculate="__EXPRESSION__"/>
    </model>
  </h:head>
  <h:body><input ref="/data/answer"><label>Answer</label></input></h:body>
</h:html>
