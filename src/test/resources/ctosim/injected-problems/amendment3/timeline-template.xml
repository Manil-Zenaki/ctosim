<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms"
        xmlns:h="http://www.w3.org/1999/xhtml"
        xmlns:jr="http://openrosa.org/javarosa" xmlns:ct="urn:ctosim:xforms">
  <h:head><h:title>Left open timeline</h:title><model>
    <instance><data id="left_open_timeline">
      __START_NODES__<finished/><screen/>__NODES__<username/><meta><instanceID/></meta>
    </data></instance>
    __START_BINDS__
    <bind nodeset="/data/finished" type="dateTime" jr:preload="timestamp" jr:preloadParams="end"/>
    <bind nodeset="/data/screen" type="int" calculate="duration()"/>
    <bind nodeset="/data/username" type="string" jr:preload="property" jr:preloadParams="username"/>
    <bind nodeset="/data/meta/instanceID" type="string" jr:preload="uid"/>
    __BINDS__
  </model></h:head>
  <h:body>__BODY__</h:body>
</h:html>
