<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:ct="urn:ctosim:xforms">
  <h:head><h:title>CLI problèmes</h:title><model>
    <instance><data id="cli_problems" version="5"><start_z/><start_a/><household/><answer/><gps/><duration_z/><durée/><children jr:template=""><item/></children><meta><instanceID/></meta></data></instance>
    <bind nodeset="/data/start_a" type="dateTime" jr:preload="timestamp" jr:preloadParams="start"/>
    <bind nodeset="/data/start_z" type="dateTime" jr:preload="timestamp" jr:preloadParams="start"/>
    <bind nodeset="/data/household" type="int"/>
    <bind nodeset="/data/answer" type="string" ct:minimum-seconds="360"/>
    <bind nodeset="/data/gps" type="geopoint"/>
    <bind nodeset="/data/durée" type="int" calculate="duration()"/>
    <bind nodeset="/data/duration_z" type="int" calculate="duration()"/>
    <bind nodeset="/data/children/item" type="string"/>
    <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
  </model></h:head>
  <h:body>
    <input ref="/data/household"><label>Household</label></input>
    <input ref="/data/answer"><label>Answer</label></input>
    <input ref="/data/gps"><label>Location</label></input>
    <repeat nodeset="/data/children"><input ref="/data/children/item"><label>Child</label></input></repeat>
  </h:body>
</h:html>
