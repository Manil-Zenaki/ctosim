<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa">
  <h:head><h:title>CLI sized ids</h:title><model>
    <instance><data id="cli_sized_ids"><district/><village/><household/><age/><category/><manual/><meta><instanceID/></meta></data></instance>
    <bind nodeset="/data/district" type="string"/>
    <bind nodeset="/data/village" type="string"/>
    <bind nodeset="/data/household" type="string"/>
    <bind nodeset="/data/age" type="int" calculate="pulldata('places','age','household',/data/household)"/>
    <bind nodeset="/data/category" type="string"/>
    <bind nodeset="/data/manual" type="string"/>
    <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
  </model></h:head>
  <h:body>
    <select1 ref="/data/district" appearance="search('places')"><label>District</label><item><label>DISTRICT</label><value>district</value></item></select1>
    <select1 ref="/data/village" appearance="search('places','matches','district',/data/district)"><label>Village</label><item><label>VILLAGE</label><value>village</value></item></select1>
    <select1 ref="/data/household" appearance="search('places','matches','village',/data/village)"><label>Household</label><item><label>HOUSEHOLD</label><value>household</value></item></select1>
    <select1 ref="/data/category" appearance="search('categories')"><label>Category</label><item><label>LABEL</label><value>category</value></item></select1>
    <input ref="/data/manual"><label>Manual id</label></input>
  </h:body>
</h:html>
