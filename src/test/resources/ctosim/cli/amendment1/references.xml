<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa">
  <h:head><h:title>Constraint references</h:title><model>
    <instance><data id="constraint_references"><zref>café 東京</zref><aref/><mref>0</mref><answer/><meta><instanceID/></meta></data></instance>
    <bind nodeset="/data/zref" type="string" readonly="true()"/>
    <bind nodeset="/data/aref" type="string" readonly="true()"/>
    <bind nodeset="/data/mref" type="string" readonly="true()"/>
    <bind nodeset="/data/answer" type="string" constraint="(.=/data/zref) and (.=/data/aref) and (.=/data/mref)"/>
    <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
  </model></h:head>
  <h:body>
    <select1 ref="/data/answer"><label>Answer</label><item><label>Only</label><value>only</value></item></select1>
  </h:body>
</h:html>
