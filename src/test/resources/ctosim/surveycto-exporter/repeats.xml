<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml"
        xmlns:jr="http://openrosa.org/javarosa">
  <h:head><h:title>Definition title</h:title><model>
    <instance><data id="export_test">
      <limit>9</limit><before/><main><member jr:template=""><member_name/><info><job jr:template=""><job_title/><tags/><gps/></job></info><member_tail/></member><plot jr:template=""><crop/></plot></main><after/>
      <meta><instanceID/></meta>
    </data></instance>
    <bind nodeset="/data/limit" type="int"/>
    <bind nodeset="/data/before" type="string"/>
    <bind nodeset="/data/main/member/member_name" type="string"/>
    <bind nodeset="/data/main/member/info/job/job_title" type="string"/>
    <bind nodeset="/data/main/member/info/job/tags" type="string"/>
    <bind nodeset="/data/main/member/info/job/gps" type="geopoint"/>
    <bind nodeset="/data/main/member/member_tail" type="string"/>
    <bind nodeset="/data/main/plot/crop" type="string"/>
    <bind nodeset="/data/after" type="string"/>
  </model></h:head>
  <h:body>
    <input ref="/data/before"><label>Before</label></input>
    <group ref="/data/main"><label>Main</label>
      <repeat nodeset="/data/main/member" jr:count="/data/limit">
        <input ref="/data/main/member/member_name"><label>Name</label></input>
        <group ref="/data/main/member/info"><label>Info</label>
          <repeat nodeset="/data/main/member/info/job" jr:count="/data/limit">
            <input ref="/data/main/member/info/job/job_title"><label>Job</label></input>
            <select ref="/data/main/member/info/job/tags"><label>Tags</label>
              <item><label>One</label><value>1</value></item>
              <item><label>None</label><value>-97</value></item>
            </select>
            <input ref="/data/main/member/info/job/gps"><label>GPS</label></input>
          </repeat>
        </group>
        <input ref="/data/main/member/member_tail"><label>Tail</label></input>
      </repeat>
      <repeat nodeset="/data/main/plot">
        <input ref="/data/main/plot/crop"><label>Crop</label></input>
      </repeat>
    </group>
    <input ref="/data/after"><label>After</label></input>
  </h:body>
</h:html>
